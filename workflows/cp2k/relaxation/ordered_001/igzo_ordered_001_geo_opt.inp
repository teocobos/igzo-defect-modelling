&GLOBAL
  PROJECT igzo_ordered_001_geo_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
  PREFERRED_DIAG_LIBRARY SCALAPACK
&END GLOBAL


&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2

    #WFN_RESTART_FILE_NAME igzo_ordered_001_geo_opt-RESTART.kp

    CHARGE 0
    MULTIPLICITY 1

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS

    &MGRID
      CUTOFF 700
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID

    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 1
    &END KPOINTS

    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      SCF_GUESS ATOMIC

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.10
        BETA 1.5
        NBUFFER 4
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR

      ADDED_MOS 40

      &PRINT
        &RESTART ON
          BACKUP_COPIES 0
          &EACH
            GEO_OPT 1
            QS_SCF 0
          &END EACH
        &END RESTART

        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

  &END DFT


  &SUBSYS

    &CELL
      A   3.2990000000   0.0000000000   0.0000000000
      B  -1.6495000000   2.8570178071   0.0000000000
      C   0.0000000000   0.0000000000  26.1010000000
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME igzo_crystal_ordered_001.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND In
      ELEMENT In
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q13
      POTENTIAL GTH-PBE-q13
    &END KIND

    &KIND Ga
      ELEMENT Ga
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q13
      POTENTIAL GTH-PBE-q13
    &END KIND

    &KIND Zn
      ELEMENT Zn
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q12
      POTENTIAL GTH-PBE-q12
    &END KIND

    &KIND O
      ELEMENT O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER CG
    MAX_ITER 200

    MAX_FORCE 4.5E-4
    RMS_FORCE 3.0E-4
    MAX_DR 3.0E-3
    RMS_DR 1.5E-3

    &CG
      &LINE_SEARCH
        TYPE GOLD
      &END LINE_SEARCH
    &END CG

  &END GEO_OPT

&END MOTION
