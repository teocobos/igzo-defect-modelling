&GLOBAL
  PROJECT igzo_ordered_003_pbe
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
  PREFERRED_DIAG_LIBRARY SCALAPACK
&END GLOBAL


&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2

    CHARGE 0
    MULTIPLICITY 1

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS

    &MGRID
      CUTOFF 700
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID

    &KPOINTS
      SCHEME MONKHORST-PACK 7 7 1
    &END KPOINTS

    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 100
      SCF_GUESS ATOMIC

      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.20
        BETA 1.5
        NBUFFER 8
      &END MIXING

      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR

      ADDED_MOS 40
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

  &END DFT


  &SUBSYS

    &CELL
      A   3.2990000000   0.0000000000   0.0000000000
      B  -1.6495000000   2.8570178071   0.0000000000
      C   0.0000000000   0.0000000000  26.1010000000
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME igzo_crystal_ordered_003.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND In
      ELEMENT In
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q13
      POTENTIAL GTH-PBE-q13
    &END KIND

    &KIND Ga
      ELEMENT Ga
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q13
      POTENTIAL GTH-PBE-q13
    &END KIND

    &KIND Zn
      ELEMENT Zn
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q12
      POTENTIAL GTH-PBE-q12
    &END KIND

    &KIND O
      ELEMENT O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

&END FORCE_EVAL
